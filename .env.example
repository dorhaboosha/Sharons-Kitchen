# ──────────────────────────────────────────
# Backend environment variables
# ──────────────────────────────────────────

# Local dev (Docker Postgres — run `docker compose up -d`)
DATABASE_URL=postgresql://sharons_kitchen:sharons_kitchen@localhost:5432/sharons_kitchen

# Production (Render Postgres — replace with your actual connection string)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Express listen port (default: 3000)
PORT=3000

# Allowed CORS origin — set to your Render frontend URL in production
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────
# Frontend environment variables (prefix with VITE_)
# ──────────────────────────────────────────

# Backend base URL used by the API client
VITE_API_URL=http://localhost:3000
