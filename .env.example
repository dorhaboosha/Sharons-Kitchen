# ──────────────────────────────────────────
# Backend environment variables
# ──────────────────────────────────────────

# REQUIRED. Local dev (Docker Postgres — run `docker compose up -d`)
DATABASE_URL=postgresql://sharons_kitchen:sharons_kitchen@localhost:5433/sharons_kitchen

# Production (Render Postgres — replace with your actual connection string)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Environment: "development" (default), "test", or "production".
# The backend refuses to start on any other value (catches typos like "prod").
# NODE_ENV=development

# Express listen port (default: 3000)
PORT=3000

# Allowed CORS origin — the exact browser origin (scheme + host, no trailing
# slash, no path). REQUIRED when NODE_ENV=production; the backend exits at
# startup if it is missing there. In development it defaults to the Vite dev
# server below.
FRONTEND_URL=http://localhost:5173

# Authentication is per-user now (see README → "Authentication"). There is no
# API token to configure: sessions are rows in the database, created by
# `POST /api/auth/login` and keyed by a random token the server never stores in
# clear. Create the first operator account with `npm run create-user`.

# ──────────────────────────────────────────
# Frontend environment variables (prefix with VITE_)
# ──────────────────────────────────────────

# Backend base URL used by the API client
VITE_API_URL=http://localhost:3000
